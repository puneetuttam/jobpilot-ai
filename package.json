{
  "name": "jobpilot-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client",
    "packages/application-engine",
    "packages/platform-adapters"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}