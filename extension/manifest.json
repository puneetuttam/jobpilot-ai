{
  "manifest_version": 3,
  "name": "JobPilot AI",
  "version": "1.0.0",
  "description": "Capture and review job listings with your own approval.",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "host_permissions": [
    "http://localhost:5000/*"
  ]
}